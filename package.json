{
  "name": "asianshop-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "npm run build:cf && opennextjs-cloudflare preview",
    "deploy": "npm run build:cf && opennextjs-cloudflare deploy",
    "upload": "npm run build:cf && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:cf": "node scripts/patch-opennext.mjs && opennextjs-cloudflare build"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@opennextjs/cloudflare": "1.20.11",
    "fuse.js": "7.5.0",
    "gsap": "3.15.0",
    "motion": "13.4.6",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.150.0"
  }
}
